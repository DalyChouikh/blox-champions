{
	"name": "blox-champions-test",
	"tree": {
		"$path": "place.project.json",
		"ReplicatedStorage": {
			"Shared": {
				"$path": "src/shared"
			},
			"Packages": {
				"$path": "Packages"
			},
			"Tests": {
				"$path": "tests"
			},
			"DevPackages": {
				"$path": "DevPackages"
			}
		},
		"ServerScriptService": {
			"$properties": {
				"LoadStringEnabled": true
			},
			"Server": {
				"$path": "src/server"
			}
		},
		"ServerStorage": {
			"RunTests": {
				"$path": "scripts/RunTests.luau"
			}
		}
	}
}
